<local:MainPageBase x:Class="Eppie.App.Views.MainPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="using:Eppie.App.UI.Behaviors"
                    xmlns:components="using:Eppie.App.UI.Components"
                    xmlns:controls="using:Eppie.App.UI.Controls"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:extensions="using:Eppie.App.UI.Extensions"
                    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
                    xmlns:local="using:Eppie.App.Views"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:viewmodels="using:Tuvi.App.ViewModels"
                    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    NavigationCacheMode="Enabled"
                    mc:Ignorable="d">
    <local:MainPageBase.DataContext>
        <viewmodels:MainPageViewModel />
    </local:MainPageBase.DataContext>

    <Grid x:Name="root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:NavigationBar x:Name="NavigationBar"
                                  Grid.Row="0"
                                  AIAgentSettingsCommand="{x:Bind OpenAIAgentsPanelCommand}"
                                  AIAgentSettingsVisibility="{x:Bind ViewModel.IsLocalAIAvailable}"
                                  AboutCommand="{x:Bind ShowAboutPageCommand}"
                                  AddressManagerCommand="{x:Bind ShowAddressManagerCommand}"
                                  AppSettingsCommand="{x:Bind ShowAppSettingsCommand}"
                                  ComposeMessageCommand="{x:Bind OpenComposeMessageCommand}"
                                  ContactsCommand="{x:Bind OpenContactsPanelCommand}"
                                  InviteCommand="{x:Bind OpenInviteDialogCommand}"
                                  LeftPaneCommand="{x:Bind ToggleLeftPaneCommand}"
                                  MailboxesCommand="{x:Bind OpenMailboxesPanelCommand}"
                                  MainPageCommand="{x:Bind ShowAllMessagesCommand}"
                                  SupportVisibility="{x:Bind ViewModel.IsSupportDevelopmentButtonVisible, Mode=OneWay}">
            <components:NavigationBar.WhatsNewFlyout>
                <Flyout x:Name="WhatsNewFlyout">
                    <controls:WhatsNewControl CloseRequested="OnWhatsNewClose"
                                              IsStorePaymentProcessor="{x:Bind ViewModel.IsStorePaymentProcessor, Mode=OneWay}"
                                              IsSupportDevelopmentButtonVisible="{x:Bind ViewModel.IsSupportDevelopmentButtonVisible, Mode=OneWay}"
                                              Price="{x:Bind ViewModel.SupportDevelopmentPrice, Mode=OneWay}"
                                              SupportDevelopmentCommand="{x:Bind ViewModel.SupportDevelopmentCommand}"
                                              TwitterUrl="{x:Bind ViewModel.TwitterPostLink, Mode=OneTime}"
                                              Version="{Binding Source={StaticResource Brand}, Path=AppVersion}" />
                </Flyout>
            </components:NavigationBar.WhatsNewFlyout>
            <components:NavigationBar.SupportFlyout>
                <Flyout x:Name="SupportFlyout">
                    <controls:SupportDevelopmentControl MaxWidth="320"
                                                        Margin="24"
                                                        IsIconVisible="True"
                                                        IsStorePaymentProcessor="{x:Bind ViewModel.IsStorePaymentProcessor, Mode=OneWay}"
                                                        Price="{x:Bind ViewModel.SupportDevelopmentPrice, Mode=OneWay}"
                                                        SupportDevelopmentCommand="{x:Bind ViewModel.SupportDevelopmentCommand}" />
                </Flyout>
            </components:NavigationBar.SupportFlyout>
        </components:NavigationBar>

        <winui:ItemsRepeater x:Name="ProblemsList"
                             Grid.Row="1"
                             MaxHeight="150"
                             Margin="0,0,0,0"
                             ElementClearing="OnElementClearing"
                             ItemsSource="{x:Bind ViewModel.Problems, Mode=OneWay}">
            <winui:ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:Problem">
                    <winui:InfoBar Title="{x:Bind Title}"
                                   HorizontalAlignment="Stretch"
                                   Background="{ThemeResource InfoBarBackground}"
                                   CloseButtonCommand="{x:Bind CloseCommand}"
                                   CloseButtonCommandParameter="{x:Bind Mode=OneWay}"
                                   IsClosable="True"
                                   IsIconVisible="True"
                                   IsOpen="True"
                                   Message="{x:Bind Message}"
                                   Severity="Warning">
                        <winui:InfoBar.ActionButton>
                            <Button Command="{x:Bind ActionCommand, Mode=OneWay}"
                                    CommandParameter="{x:Bind Mode=OneWay}"
                                    Content="{x:Bind SolutionText, Mode=OneWay}" />
                        </winui:InfoBar.ActionButton>
                    </winui:InfoBar>
                </DataTemplate>
            </winui:ItemsRepeater.ItemTemplate>
        </winui:ItemsRepeater>

        <controls:SidePane x:Name="LeftSidePane"
                           Grid.Row="2"
                           ChildMinWidth="360"
                           OpenPaneMaxLength="360">
            <controls:SidePane.Pane>
                <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Frame x:Name="LeftSidePaneFrame" />
                </Border>
            </controls:SidePane.Pane>
            <SplitView x:Name="splitView"
                       Grid.Row="2"
                       DisplayMode="Inline"
                       IsPaneOpen="False"
                       PaneBackground="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <SplitView.Pane>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Frame x:Name="paneFrame" />

                        <AppBarButton Grid.Column="1"
                                      Width="48"
                                      Height="48"
                                      VerticalAlignment="Top"
                                      Command="{x:Bind ClosePaneCommand}">
                            <SymbolIcon Symbol="Cancel" />
                        </AppBarButton>

                    </Grid>
                </SplitView.Pane>
                <Frame x:Name="contentFrame" />
            </SplitView>
        </controls:SidePane>
    </Grid>
</local:MainPageBase>
