<UserControl x:Class="Eppie.App.UI.Components.SupportDevelopmentBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="300"
             d:DesignWidth="400"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SupportDevelopmentSubtitleTextBlockStyle"
               BasedOn="{StaticResource SubtitleTextBlockStyle}"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <x:Double x:Key="SupportIconSize">92</x:Double>
        <x:Double x:Key="SupportIconGlyphSize">48</x:Double>
    </UserControl.Resources>

    <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="12">

                <!--  Todo: Perhaps we should use different colors for different themes.  -->
                <Grid HorizontalAlignment="Left" Visibility="{x:Bind IsIconVisible, Mode=OneTime}">
                    <Ellipse Width="{StaticResource SupportIconSize}"
                             Height="{StaticResource SupportIconSize}"
                             Fill="#F0F0F0" />
                    <FontIcon HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              FontSize="{StaticResource SupportIconGlyphSize}"
                              Foreground="Black"
                              Glyph="{StaticResource HeartFillGlyph}" />
                </Grid>

                <TextBlock x:Uid="SupportDevelopmentCaption" Style="{StaticResource SupportDevelopmentSubtitleTextBlockStyle}" />

                <StackPanel>
                    <TextBlock x:Uid="SupportDevelopmentText" TextWrapping="Wrap" />
                    <TextBlock x:Uid="SupportDevelopmentStoreProvider"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind IsStorePaymentProcessor, Mode=OneTime}" />
                    <TextBlock x:Uid="SupportDevelopmentGitHubProvider"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind IsStorePaymentProcessor, Mode=OneTime, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Bottom"
                               FontSize="22"
                               FontWeight="Bold"
                               Text="{x:Bind Price, Mode=OneWay}"
                               TextLineBounds="TrimToBaseline" />
                    <TextBlock x:Uid="PricePerMonthText"
                               Margin="4,0,0,0"
                               VerticalAlignment="Bottom"
                               TextLineBounds="TrimToBaseline" />
                </StackPanel>
            </StackPanel>
            <Button x:Uid="SupportDevelopmentShortButton"
                    Grid.Row="1"
                    Margin="0,28,0,0"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind SupportDevelopmentCommand, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
